[Unit]
Description=Sinty login, session and seat manager
Documentation=https://github.com/singularityos-lab/sinty-logind
Wants=dbus.service
After=dbus.service
Before=singularity-compositor.service

[Service]
Type=simple
ExecStartPre=-/bin/mkdir -p /run/singularity /run/user/102
ExecStartPre=-/bin/chown greeter:singularity-session /run/singularity
ExecStartPre=-/bin/chmod 0770 /run/singularity
ExecStartPre=-/bin/chown greeter /run/user/102
ExecStartPre=-/bin/chmod 0700 /run/user/102
ExecStart=/usr/libexec/sinty-logind
Restart=always
RestartSec=1

[Install]
WantedBy=graphical.target
